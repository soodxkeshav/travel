# Copy to .env.local and fill in (exact same values apply to production deployment secrets).
# Z.ai -> https://z.ai  (Developer API -> API keys)
# Paste ZAI_API_KEY to the agent; it never goes into the browser.
ZAI_API_KEY=
ZAI_API_BASE=https://api.z.ai/api/paas/v4
# Optional: model name (default glm-4-flash)
# ZAI_MODEL=glm-4-flash
